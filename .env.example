# Database (Supabase PostgreSQL Connection Strings)
# Pooled connection string (Transaction mode, port 6543) for application queries:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string (Session mode, port 5432) for migrations:
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API credentials
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Authentication & Security
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="super-secret-jwt-key"

# Platform Defaults (Bangladesh First)
DEFAULT_TIMEZONE="Asia/Dhaka"
DEFAULT_CURRENCY="BDT"
DEFAULT_COUNTRY_CODE="+880"

# Messaging Providers (Configurable in DB, env fallback)
META_WA_PHONE_NUMBER_ID=""
META_WA_ACCESS_TOKEN=""
META_WA_VERIFY_TOKEN=""

SMS_PROVIDER="mock" # mock | sslwireless | bulksmsbd | twilio
SMS_API_KEY=""
SMS_SENDER_ID=""

EMAIL_PROVIDER="mock" # mock | resend | smtp
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Redis / Queue (Optional for local dev, Upstash or Redis URL)
REDIS_URL="redis://localhost:6379"
