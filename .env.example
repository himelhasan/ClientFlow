# ==============================================================================
# ClientFlow — Multi-Tenant Lead, Booking & Automation Platform
# Environment Configuration Template (Section 59)
# ==============================================================================

# 1. PostgreSQL / Supabase Database Connection
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.compute.amazonaws.com:5432/postgres"

# 2. Supabase Public Client (Optional Realtime / Storage)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 3. Authentication & Session Security
JWT_SECRET="replace-with-a-64-char-cryptographic-random-secret"

# 4. Meta WhatsApp Cloud API & Social Webhooks (Phase 3 & 4)
META_WA_PHONE_NUMBER_ID="your-meta-whatsapp-phone-number-id"
META_WA_ACCESS_TOKEN="your-meta-system-user-permanent-access-token"
META_WEBHOOK_VERIFY_TOKEN="clientflow_meta_verify_2026"

# 5. Bangladesh SMS Gateway (BulkSMSBD / SSL Wireless / Greenweb)
SMS_API_KEY="your-bd-sms-gateway-api-key"
SMS_SENDER_ID="ClientFlow"

# 6. Email Transactional Provider (Resend / SMTP)
RESEND_API_KEY="re_your_resend_api_key"
